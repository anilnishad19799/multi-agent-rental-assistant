# ==========================================
# Application Configuration (.env)
# ==========================================

# Active LLM Provider: "groq", "openai", or "gemini"
LLM_PROVIDER=groq

# Groq API Settings
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI Settings (optional if using groq)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini Settings (optional if using groq)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Database
DATABASE_URL=sqlite+aiosqlite:///./rental_system.db

# PubSub Backend (memory | redis)
PUBSUB_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Observability & Tracing (LangSmith)
# Set LANGCHAIN_TRACING_V2=true to stream full multi-agent traces directly to LangSmith Cloud
LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=real-estate-rental-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
